<?xml version="1.0" encoding="utf-8"?>
<!--
  Refurb USB answer file - Windows 11 Pro, unattended install into AUDIT MODE.
  WARNING: this WIPES DISK 0 (unless disk 0 is a USB drive, then it shuts down) of whatever computer boots from this USB. Label the stick.
  Flow: Windows Setup (no prompts) -> boots to Audit Mode as built-in Administrator
        -> auditUser pass starts D:\refurb\audit.ps1 (or whichever letter the USB gets).
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <!-- Safety: if disk 0 is a USB drive (e.g. this stick), shut down instead of wiping it.
             Every command here must exit 0 on success: Setup treats any other exit code as fatal. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Stop if disk 0 is a USB drive</Description>
          <Path>cmd.exe /c (echo select disk 0&amp;echo detail disk)&gt;X:\diskcheck.txt &amp; diskpart /s X:\diskcheck.txt | findstr /r /c:"Type *: USB" &gt;nul &amp;&amp; wpeutil shutdown &amp; exit 0</Path>
        </RunSynchronousCommand>
        <!-- Partition disk 0 with a diskpart script (more reliable with the 24H2+ setup than DiskConfiguration). -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Description>Write diskpart script, part 1</Description>
          <Path>cmd.exe /c &gt;X:\dp.txt (echo select disk 0&amp;echo clean&amp;echo convert gpt&amp;echo create partition efi size=300&amp;echo format quick fs=fat32 label=System)</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Description>Write diskpart script, part 2</Description>
          <Path>cmd.exe /c &gt;&gt;X:\dp.txt (echo create partition msr size=16&amp;echo create partition primary&amp;echo format quick fs=ntfs label=Windows&amp;echo exit)</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Description>Run diskpart; pause and show the log if it fails</Description>
          <Path>cmd.exe /c diskpart /s X:\dp.txt &gt;X:\dp.log || (type X:\dp.log &amp; echo DISKPART FAILED - take a photo of this screen &amp; pause &amp; exit 1)</Path>
        </RunSynchronousCommand>
      </RunSynchronous>

      <ImageInstall>
        <OSImage>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
      </UserData>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <!-- Boot into Audit Mode instead of customer setup. The audit script deletes the cached
         copy of this file before resealing, so the buyer gets normal first-time setup. -->
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <Reseal>
        <Mode>Audit</Mode>
      </Reseal>
    </component>
  </settings>

  <settings pass="auditUser">
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Start refurb audit script from the USB</Description>
          <Path>cmd.exe /c for %i in (D E F G H I J K L M N O P) do @if exist %i:\refurb\audit.ps1 start "Refurb" powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File %i:\refurb\audit.ps1</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

</unattend>
